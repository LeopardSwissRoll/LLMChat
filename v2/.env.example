# ─────────────────────────────────────────────────────────────
# v2 PTY Bridge — 환경 설정 예시
# 복사해서 v2/.env 로 저장한 뒤 값을 채우세요. (.env 는 git 에서 제외됨)
# 값이 비어 있으면 v2/default_state.json 의 같은 키가 fallback 으로 쓰입니다.
# ─────────────────────────────────────────────────────────────

# ── Discord ──
DISCORD_BOT_TOKEN=
# 페르소나 정의 (JSON). key = persona_id.
#   dir        : v2/prompts/<dir>/PROMPT.md 를 읽는다
#   aka        : 역할 멘션 별칭 (문자열 또는 배열)
#   avatar_url : 웹훅 아바타
PERSONAS={"example": {"dir": "example", "aka": ["Example"], "avatar_url": ""}}

# 봇이 CLI 를 실행할 작업 폴더 (기본: ./Playground)
DEFAULT_WORKSPACE=Playground

# ── 페르소나 공통 ──
# DEFAULT_IDENTITY_TEXT=PTY Bridge
# ENABLED_PROVIDERS=claude,codex
# PTY_ROWS=50
# PTY_COLS=200
# MESSAGE_EDIT_INTERVAL=2.0     # 스트리밍 미리보기 갱신 간격(초)
# RESPONSE_TIMEOUT=1800         # 한 턴 최대 대기(초)
# IDLE_SECONDS=3.0              # 이 시간 동안 PTY 출력이 없으면 응답 완료로 간주

# ── 모드 / 접근 제어 ──
# DEFAULT_MODE=4                # 1 core · 2 soft · 3 medium · 4 hard · 5 masquerade
# DEFAULT_PROVIDER=claude
# DEFAULT_COMMAND_ACCESS=public # public | protagonist
# DEFAULT_LV1_ADD_DIRS=channel,persona
# DEFAULT_ADD_DIRS=channel,users,persona
# LOG_LEVEL=INFO

# ── Claude Code CLI ──
# CLAUDE_ENABLED=true
# CLAUDE_CLI_EXECUTABLE=claude
# CLAUDE_CLI_ARGS=["--verbose"]
# CLAUDE_DEFAULT_MODEL=opus
# CLAUDE_DEFAULT_EFFORT=high
# CLAUDE_DEFAULT_PERMISSION=bypass   # default | plan | bypass
# CLAUDE_DEFAULT_FAST=false

# ── OpenAI Codex CLI ──
# CODEX_ENABLED=true
# CODEX_CLI_EXECUTABLE=codex
# CODEX_CLI_ARGS=["--no-alt-screen"]
# CODEX_DEFAULT_MODEL=gpt-5.4
# CODEX_DEFAULT_EFFORT=xhigh
# CODEX_DEFAULT_PERMISSION=bypass
# CODEX_DEFAULT_FAST=false

# ── 웹 퍼블리셔 (선택: 긴 응답을 웹 페이지로, 라이브 터미널 뷰어) ──
# WEB_PUBLISH_ENABLED=false
# WEB_PUBLISH_PORT=8080
# WEB_PUBLISH_BASE_URL=            # 외부 접근 시 공개 URL (예: Cloudflare Tunnel)
# WEB_PUBLISH_GUILD_ID=            # 이 서버 멤버만 열람 허용
# WEB_PUBLISH_THRESHOLD=500        # 이 길이 이상이면 요약 + 링크로 전송
# WEB_PUBLISH_SUMMARY_LENGTH=200
# DISCORD_CLIENT_ID=               # OAuth2 앱
# DISCORD_CLIENT_SECRET=

# ── cli.py ──
# PLAYGROUND_DIR=
